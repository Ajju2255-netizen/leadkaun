# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@leadkaun.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — use rzp_test_* keys locally, NEVER rzp_live_*.
# WEBHOOK_SECRET is set when you create the webhook in the Razorpay Dashboard
# (Settings → Webhooks). It is a separate value from KEY_SECRET.
# After filling these in, run: npx tsx scripts/razorpay-sync-plans.ts
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Mission Control (admin.leadkaun.com) ──────────────────────────────────────
# Platform admin auth needs all three of: this allowlist, an active row in
# platform_admins, and (when MFA is on) a Supabase AAL2 session.
#
# PLATFORM_ADMIN_EMAILS is the env kill-switch. Leave it unset and EVERY admin
# login is rejected — the panel is unreachable, with no error beyond a redirect
# back to /admin/login.
PLATFORM_ADMIN_EMAILS=

# Require TOTP (Supabase AAL2) for platform admins. Should be "true" anywhere
# with real customer data — a platform admin can impersonate any tenant.
PLATFORM_MFA_REQUIRED=true

# Where the admin panel lives; used for the post-impersonation redirect back.
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Optional — Slack webhook for signup alerts and the daily insights digest.
ADMIN_SLACK_WEBHOOK_URL=

# Dev-only auth bypass: signs you in as the first active platform_admins row
# with no password. Ignored when NODE_ENV=production, AND refused unless
# DATABASE_URL points at a local Postgres (see lib/auth/platform.ts). Never put
# this in .env.local.prod — use-db.sh copies that file onto .env.local.
DEV_AUTH_BYPASS=true
